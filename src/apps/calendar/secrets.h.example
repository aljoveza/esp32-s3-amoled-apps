// =========================================================================
//  Calendar — secrets template.
//
//  Copy this file to secrets.h (gitignored, never commit it) and fill in
//  the values below. See SETUP.md for how to get a Google OAuth client and
//  refresh token -- the refresh token comes from running
//  tools/get_refresh_token.py once on your computer, not from anything on
//  the device.
// =========================================================================

#define WIFI_SSID             "your-wifi-name"
#define WIFI_PASSWORD         "your-wifi-password"

#define GOOGLE_CLIENT_ID      "your-client-id.apps.googleusercontent.com"
#define GOOGLE_CLIENT_SECRET  "your-client-secret"
#define GOOGLE_REFRESH_TOKEN  "your-refresh-token"
